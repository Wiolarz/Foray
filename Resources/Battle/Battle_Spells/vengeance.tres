[resource]
script = ExtResource("1_oxtud")
name = "Vengeance"
icon_path = "res://Art/magic/spell_icons/vengence.png"
description = "Choose an ally unit -> For the next 6 turns
if an enemy unit during their turn were to make a move, leading to this units death, it will die too

But if it were to be the last unit killed, spell won't take effect as the battle will be over."
