[resource]
script = ExtResource("1_2dgil")
name = "Wind Dash"
icon_path = "res://Art/magic/spell_icons/wind_dash.png"
description = "Choose a tile directly in front of the caster ->
Caster traverses 3 tiles forward attacking before getting hit by enemy spears.

If unit along casters path were to survive his attacks. (ex. because it had a shield)
Caster will be squashed"
cast_range = 1
direction_cast = 1
target_type = 2
needs_movable_tile = true
target_unit_type = 0
not_self = true
needs_empty_front_tile = false
